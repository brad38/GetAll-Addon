    {
      "id": "tracks",
      "kind": "directory",
      "name": "Disc tracks",
      "required": true,
      "validate_cue_references": true,
      "files": [
        {
          "path": "disc.cue",
          "size": 128,
          "sha256": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        },
        {
          "path": "track01.bin",
          "size": 2352,
          "sha256": "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"
        }
      ]
    }
  ],
  "launch_file": "game.exe"
}
