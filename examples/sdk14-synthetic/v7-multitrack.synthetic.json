{
  "schema_version": 7,
  "project_id": "synthetic-disc",
  "tag": "v0.0-test",
  "source_url": "https://github.com/example/disc",
  "operations": [
    {
      "kind": "import_input_set",
      "source": "tracks",
      "target": "disc",
      "scope": "installation"
    }
  ],
  "required_files": [
    "game.exe",
    "disc/disc.cue",
    "disc/track01.bin"
  ],
