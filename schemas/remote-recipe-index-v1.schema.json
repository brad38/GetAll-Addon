{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "index_format_version",
    "recipes"
  ],
  "properties": {
    "index_format_version": {
      "const": 1
    },
    "channel": {
      "enum": [
        "public",
        "preview"
      ]
    },
    "recipes": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "required": [
          "game_id",
          "project_id",
          "repository",
          "tag",
          "schema_version",
          "path",
          "sha256",
          "status"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,160}$"
          },
          "project_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,160}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9-]+/[A-Za-z0-9_.-]+|gitlab:[A-Za-z0-9][A-Za-z0-9_.-]*(?:/[A-Za-z0-9][A-Za-z0-9_.-]*){1,7})$",
            "maxLength": 200
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "min_sdk_version": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "allOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*\\.json$"
              },
              {
                "pattern": "^recipes/"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "status": {
            "enum": [
              "validated",
              "disabled",
              "draft",
              "experimental"
            ]
          },
          "has_inputs": {
            "type": "boolean"
          },
          "has_manual_steps": {
            "type": "boolean"
          },
          "disabled_reason": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          },
          "disabled_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "audit_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "disabled"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "disabled_reason",
                "disabled_at",
                "audit_reference"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "disabled_reason"
                    ]
                  },
                  {
                    "required": [
                      "disabled_at"
                    ]
                  },
                  {
                    "required": [
                      "audit_reference"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "execution_policy": {
      "const": "official_upstream_only"
    }
  }
}
