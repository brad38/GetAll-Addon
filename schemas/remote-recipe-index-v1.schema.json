{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetAll-Addon Remote Recipe Index v1 (SDK 1.1)",
  "type": "object",
  "required": [
    "index_format_version",
    "recipes"
  ],
  "properties": {
    "index_format_version": {
      "const": 1
    },
    "recipes": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "required": [
          "game_id",
          "project_id",
          "repository",
          "tag",
          "schema_version",
          "path",
          "sha256",
          "status"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,160}$"
          },
          "project_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,160}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$",
            "maxLength": 200
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "allOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*\\.json$"
              },
              {
                "pattern": "^recipes/"
              }
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "status": {
            "enum": [
              "validated",
              "disabled",
              "draft",
              "experimental"
            ]
          },
          "has_inputs": {
            "type": "boolean"
          },
          "has_manual_steps": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
