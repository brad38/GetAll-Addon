{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "All-Fix Installation Recipe v8 - restricted Java 25 classpath launch",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "tag",
    "source_url",
    "operations",
    "required_files",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": 8
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "operations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "anyOf": [
          {
            "$ref": "installation-recipe-v1.schema.json#/properties/operations/items"
          },
          {
            "type": "object",
            "required": [
              "kind",
              "source",
              "target",
              "scope"
            ],
            "properties": {
              "kind": {
                "const": "import_input"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "$ref": "installation-recipe-v1.schema.json#/$defs/path"
              },
              "scope": {
                "enum": [
                  "installation",
                  "roaming_app_data",
                  "local_app_data"
                ]
              },
              "profile_folders": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "allOf": [
                    {
                      "$ref": "installation-recipe-v1.schema.json#/$defs/path"
                    },
                    {
                      "maxLength": 160
                    }
                  ]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "scope": {
                      "enum": [
                        "roaming_app_data",
                        "local_app_data"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "profile_folders"
                  ],
                  "properties": {
                    "target": {
                      "allOf": [
                        {
                          "$ref": "installation-recipe-v1.schema.json#/$defs/path"
                        },
                        {
                          "pattern": "\\.(?:[zZ]64|[nN]64|[vV]64|[rR][oO][mM]|[bB][iI][nN]|[dD][aA][tT]|[pP][aA][kK]|[wW][aA][dD]|[sS][fF][cC]|[sS][mM][cC]|[gG][bB][aA])$"
                        }
                      ]
                    }
                  }
                },
                "else": {
                  "not": {
                    "required": [
                      "profile_folders"
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "required": [
              "kind",
              "scope",
              "source",
              "target"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "import_input_set"
              },
              "scope": {
                "const": "installation"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "target": {
                "$ref": "installation-recipe-v1.schema.json#/$defs/path"
              }
            }
          }
        ]
      }
    },
    "required_files": {
      "$ref": "installation-recipe-v1.schema.json#/properties/required_files"
    },
    "manual_steps": {
      "type": "string",
      "maxLength": 2000
    },
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "kind": {
                    "enum": [
                      "file",
                      "directory"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 68719476736
                  },
                  "magic_hex": {
                    "type": "string",
                    "pattern": "^(?:[A-Fa-f0-9]{2}){2,32}$"
                  },
                  "verify_file": {
                    "$ref": "installation-recipe-v1.schema.json#/$defs/path"
                  },
                  "extensions": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                      "type": "string",
                      "pattern": "^\\.[A-Za-z0-9]{1,12}$"
                    }
                  },
                  "required": {
                    "type": "boolean",
                    "default": true
                  },
                  "sha1": {
                    "type": "string",
                    "pattern": "^[A-Fa-f0-9]{40}$"
                  },
                  "min_size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 68719476736
                  },
                  "max_size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 68719476736
                  },
                  "md5": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{32}$"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "required": [
                        "name"
                      ],
                      "anyOf": [
                        {
                          "required": [
                            "sha256"
                          ]
                        },
                        {
                          "required": [
                            "size",
                            "magic_hex"
                          ]
                        },
                        {
                          "required": [
                            "sha1"
                          ]
                        },
                        {
                          "required": [
                            "min_size",
                            "magic_hex"
                          ]
                        }
                      ]
                    },
                    "else": {
                      "required": [
                        "sha256"
                      ],
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "md5"
                            ]
                          },
                          {
                            "required": [
                              "min_size"
                            ]
                          },
                          {
                            "required": [
                              "max_size"
                            ]
                          }
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "const": "directory"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "verify_file"
                      ]
                    }
                  }
                ]
              },
              {
                "not": {
                  "required": [
                    "files"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name",
              "files"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "const": "directory"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "required": {
                "const": true
              },
              "files": {
                "$ref": "#/$defs/importFiles"
              },
              "validate_cue_references": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "kind",
              "name",
              "files"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "const": "arcade_romset"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "required": {
                "const": true
              },
              "files": {
                "$ref": "#/$defs/arcadeRomFiles"
              }
            }
          }
        ]
      }
    },
    "launch_file": {
      "$ref": "installation-recipe-v1.schema.json#/$defs/path"
    },
    "first_run_files": {
      "$ref": "#/$defs/firstRunFiles"
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dotnet-desktop-10-x64",
          "java-21",
          "openal-x64",
          "openal-x86",
          "java-25"
        ]
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "target",
          "size",
          "sha256",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^/\\\\:*?\"<>|\\x00-\\x1F]+$"
          },
          "target": {
            "$ref": "installation-recipe-v1.schema.json#/$defs/path"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "kind": {
            "enum": [
              "portable_executable",
              "payload"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "payload"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "target": {
                  "not": {
                    "pattern": "(?:\\.[eE][xX][eE]|\\.[mM][sS][iI]|\\.[cC][mM][dD]|\\.[bB][aA][tT]|\\.[pP][sS]1|\\.[vV][bB][sS]|\\.[wW][sS][fF]|\\.[sS][cC][rR]|\\.[pP][iI][fF]|\\.[cC][oO][mM])$"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "portable_executable"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "target": {
                  "pattern": "\\.[eE][xX][eE]$"
                }
              }
            }
          }
        ]
      }
    },
    "java_launcher": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jar",
            "runtime"
          ],
          "properties": {
            "jar": {
              "allOf": [
                {
                  "$ref": "installation-recipe-v1.schema.json#/$defs/path"
                },
                {
                  "pattern": "\\.[jJ][aA][rR]$"
                }
              ]
            },
            "runtime": {
              "enum": [
                "java-21",
                "java-25"
              ]
            },
            "working_directory": {
              "$ref": "installation-recipe-v1.schema.json#/$defs/path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "jar",
            "runtime",
            "main_class",
            "classpath"
          ],
          "properties": {
            "jar": {
              "allOf": [
                {
                  "$ref": "installation-recipe-v1.schema.json#/$defs/path"
                },
                {
                  "pattern": "\\.[jJ][aA][rR]$"
                }
              ]
            },
            "runtime": {
              "enum": [
                "java-21",
                "java-25"
              ]
            },
            "working_directory": {
              "$ref": "installation-recipe-v1.schema.json#/$defs/path"
            },
            "main_class": {
              "type": "string",
              "maxLength": 180,
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)+$"
            },
            "classpath": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "allOf": [
                  {
                    "$ref": "installation-recipe-v1.schema.json#/$defs/path"
                  },
                  {
                    "pattern": "\\.[jJ][aA][rR]$"
                  }
                ]
              }
            },
            "jvm_options": {
              "type": "array",
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "joml-fastmath",
                  "joml-sin-lookup",
                  "joml-fma",
                  "open-java-util",
                  "export-jdk-internal-misc",
                  "enable-native-access"
                ]
              }
            },
            "program_arguments_profile": {
              "const": "severed-chains-3"
            }
          }
        }
      ]
    },
    "installer_profile": false,
    "build_profile": false
  },
  "$defs": {
    "verifiedDataFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "allOf": [
              {
                "$ref": "installation-recipe-v1.schema.json#/$defs/path"
              },
              {
                "pattern": "\\.(?:[bB][iI][nN]|[cC][uU][eE]|[iI][sS][oO]|[iI][mM][gG]|[dD][aA][tT]|[pP][aA][kK]|[wW][aA][dD]|[rR][oO][mM]|[zZ]64|[nN]64|[vV]64|[oO]2[rR]|[oO][tT][rR]|[wW][aA][vV]|[rR][aA][wW]|[cC][hH][dD]|[gG][dD][iI]|[vV][pP][kK]|[wW][mM][aA]|[mM][pP]3|[oO][gG][gG]|[sS][fF][cC]|[sS][mM][cC]|[gG][bB][aA])$"
              }
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "min_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "max_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "magic_hex": {
            "type": "string",
            "pattern": "^(?:[0-9A-Fa-f]{2}){2,32}$"
          },
          "sha1": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{40}$"
          }
        },
        "anyOf": [
          {
            "required": [
              "sha256"
            ]
          },
          {
            "required": [
              "sha1"
            ]
          },
          {
            "required": [
              "size",
              "magic_hex"
            ]
          },
          {
            "required": [
              "min_size",
              "magic_hex"
            ]
          }
        ]
      }
    },
    "importFiles": {
      "allOf": [
        {
          "$ref": "#/$defs/verifiedDataFiles"
        },
        {
          "items": {
            "anyOf": [
              {
                "required": [
                  "size"
                ]
              },
              {
                "required": [
                  "max_size"
                ]
              }
            ]
          }
        }
      ]
    },
    "firstRunFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "allOf": [
              {
                "$ref": "installation-recipe-v1.schema.json#/$defs/path"
              },
              {
                "pattern": "\\.(?:[bB][iI][nN]|[cC][uU][eE]|[iI][sS][oO]|[iI][mM][gG]|[dD][aA][tT]|[pP][aA][kK]|[wW][aA][dD]|[rR][oO][mM]|[zZ]64|[nN]64|[vV]64|[oO]2[rR]|[oO][tT][rR]|[wW][aA][vV]|[rR][aA][wW]|[cC][hH][dD]|[gG][dD][iI]|[vV][pP][kK]|[wW][mM][aA]|[mM][pP]3|[oO][gG][gG]|[sS][fF][cC]|[sS][mM][cC]|[gG][bB][aA])$"
              }
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "min_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "max_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "magic_hex": {
            "type": "string",
            "pattern": "^(?:[0-9A-Fa-f]{2}){2,32}$"
          },
          "sha1": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{40}$"
          },
          "scope": {
            "enum": [
              "installation",
              "local_app_data",
              "roaming_app_data"
            ]
          },
          "profile_folder": {
            "allOf": [
              {
                "$ref": "installation-recipe-v1.schema.json#/$defs/path"
              },
              {
                "maxLength": 160
              }
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "sha256"
            ]
          },
          {
            "required": [
              "sha1"
            ]
          },
          {
            "required": [
              "size",
              "magic_hex"
            ]
          },
          {
            "required": [
              "min_size",
              "magic_hex"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "scope"
              ],
              "properties": {
                "scope": {
                  "enum": [
                    "local_app_data",
                    "roaming_app_data"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "profile_folder"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "profile_folder"
                ]
              }
            }
          }
        ]
      }
    },
    "arcadeVerifiedFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "allOf": [
              {
                "$ref": "installation-recipe-v1.schema.json#/$defs/path"
              },
              {
                "pattern": "\\.(?:[bB][iI][nN]|[cC][uU][eE]|[iI][sS][oO]|[iI][mM][gG]|[dD][aA][tT]|[pP][aA][kK]|[wW][aA][dD]|[rR][oO][mM]|[zZ]64|[nN]64|[vV]64|[oO]2[rR]|[oO][tT][rR]|[wW][aA][vV]|[rR][aA][wW]|[cC][hH][dD]|[gG][dD][iI]|[vV][pP][kK]|[wW][mM][aA]|[mM][pP]3|[oO][gG][gG]|[sS][fF][cC]|[sS][mM][cC]|[gG][bB][aA]|[0-9]{1,3})$"
              }
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "min_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "max_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "magic_hex": {
            "type": "string",
            "pattern": "^(?:[0-9A-Fa-f]{2}){2,32}$"
          },
          "sha1": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{40}$"
          },
          "crc32": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}$"
          }
        },
        "anyOf": [
          {
            "required": [
              "sha256"
            ]
          },
          {
            "required": [
              "sha1"
            ]
          },
          {
            "required": [
              "size",
              "magic_hex"
            ]
          },
          {
            "required": [
              "min_size",
              "magic_hex"
            ]
          },
          {
            "required": [
              "size",
              "crc32"
            ]
          }
        ]
      }
    },
    "arcadeRomFiles": {
      "allOf": [
        {
          "$ref": "#/$defs/arcadeVerifiedFiles"
        },
        {
          "items": {
            "required": [
              "size"
            ]
          }
        }
      ]
    }
  },
  "dependentRequired": {
    "first_run_files": [
      "manual_steps",
      "launch_file"
    ]
  }
}
