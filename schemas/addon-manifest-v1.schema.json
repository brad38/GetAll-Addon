{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "api_version",
    "entrypoint",
    "capabilities",
    "permissions"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,7})(\\.(0|[1-9][0-9]{0,7})){2}$"
    },
    "api_version": {
      "const": "1.0"
    },
    "entrypoint": {
      "const": "responses.json"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
        "maxLength": 100
      }
    },
    "permissions": {
      "const": []
    },
    "priority": {
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "author": {
      "type": "string",
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "min_sdk_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,7})(\\.(0|[1-9][0-9]{0,7})){2}$"
    },
    "max_sdk_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,7})(\\.(0|[1-9][0-9]{0,7})){2}$"
    }
  }
}
