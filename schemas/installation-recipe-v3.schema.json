{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "All-Fix Installation Recipe v3",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "tag",
    "source_url",
    "operations",
    "required_files",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "operations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "anyOf": [
          {
            "$ref": "installation-recipe-v1.schema.json#/properties/operations/items"
          },
          {
            "type": "object",
            "required": [
              "kind",
              "source",
              "target",
              "scope"
            ],
            "properties": {
              "kind": {
                "const": "import_input"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "$ref": "installation-recipe-v1.schema.json#/$defs/path"
              },
              "scope": {
                "enum": [
                  "installation",
                  "roaming_app_data"
                ]
              },
              "profile_folders": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,79}$"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "scope": {
                      "const": "roaming_app_data"
                    }
                  }
                },
                "then": {
                  "required": [
                    "profile_folders"
                  ],
                  "properties": {
                    "target": {
                      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.(z64|n64|v64|rom|bin|dat|pak|wad)$"
                    }
                  }
                },
                "else": {
                  "not": {
                    "required": [
                      "profile_folders"
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "required_files": {
      "$ref": "installation-recipe-v1.schema.json#/properties/required_files"
    },
    "manual_steps": {
      "type": "string",
      "maxLength": 2000
    },
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 68719476736
          },
          "magic_hex": {
            "type": "string",
            "pattern": "^(?:[A-Fa-f0-9]{2}){2,32}$"
          },
          "verify_file": {
            "$ref": "installation-recipe-v1.schema.json#/$defs/path"
          },
          "extensions": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "pattern": "^\\.[A-Za-z0-9]{1,12}$"
            }
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "sha1": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{40}$"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "name"
              ],
              "anyOf": [
                {
                  "required": [
                    "sha256"
                  ]
                },
                {
                  "required": [
                    "size",
                    "magic_hex"
                  ]
                }
              ]
            },
            "else": {
              "required": [
                "sha256"
              ]
            }
          },
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "directory"
                }
              }
            },
            "then": {
              "required": [
                "verify_file"
              ]
            }
          }
        ]
      }
    },
    "launch_file": {
      "$ref": "installation-recipe-v1.schema.json#/$defs/path"
    }
  }
}
